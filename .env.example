# Sao chép file này thành .env rồi điền giá trị thật (KHÔNG commit file .env)
PORT=5000

# MySQL (XAMPP mặc định: user root, mật khẩu rỗng, cổng 3306)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=moc_coffee

# Chuỗi bí mật tự đặt, dài ÍT NHẤT 32 ký tự. Thiếu hoặc quá ngắn thì server không khởi động.
JWT_SECRET=
# Thời hạn đăng nhập (tùy chọn)
JWT_EXPIRES_IN=8h